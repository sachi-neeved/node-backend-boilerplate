		"husky": "^9.1.7",
		"mongodb-memory-server": "^11.2.0",
		"nodemon": "^3.1.14",
		"react-email": "^6.8.1",
		"supertest": "^7.2.2",
		"ts-loader": "^9.6.2",
		"ts-node": "^10.9.2",
		"ts-node-dev": "^2.0.0",
