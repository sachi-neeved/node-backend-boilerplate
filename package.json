{
	"name": "NeevRecruit Backend",
	"version": "1.0.0",
	"main": "index.js",
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"dev": "cross-env NODE_ENV=development nodemon",
		"start": "cross-env NODE_ENV=production nodemon",
		"prepare": "husky",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check .",
		"check:ci": "biome ci .",
		"spell": "cspell",
		"email:preview": "email dev --dir src/views",
		"test:unit": "vitest run src",
		"test:watch": "vitest",
		"test:e2e": "vitest run e2e",
		"test:coverage": "vitest run src e2e --coverage"
	},
	"packageManager": "pnpm@11.0.8",
	"engines": {
		"node": ">=24.0.0",
		"pnpm": ">=11.0.0"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"description": "",
	"dependencies": {
		"@asteasolutions/zod-to-openapi": "^9.0.0",
		"@casl/ability": "^7.0.1",
		"@react-email/components": "^1.0.12",
		"@react-email/render": "^2.1.0",
		"@types/cookie-parser": "^1.4.10",
		"bcryptjs": "^3.0.3",
		"compression": "^1.8.1",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"dotenv-safe": "^9.1.0",
		"expeditious-engine-redis": "^0.1.2",
		"express": "^5.2.1",
		"express-expeditious": "^5.1.1",
		"jsonwebtoken": "^9.0.3",
		"mongodb": "^7.5.0",
		"mongoose": "^9.7.4",
		"nodemailer": "^9.0.3",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"swagger-ui-express": "^5.0.1",
		"winston": "^3.19.0",
		"winston-daily-rotate-file": "^5.0.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.3",
		"@react-email/ui": "6.8.1",
		"@types/compression": "^1.8.1",
		"@types/cors": "^2.8.19",
		"@types/dotenv-safe": "^9.1.0",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
