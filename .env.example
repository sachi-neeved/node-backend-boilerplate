# Database
MONGO_URI=mongodb://localhost:27017/nodejs-boilerplate

# Server
PORT=8000
NODE_ENV=development

# Auth — use a long random string in production
JWT_SECRET_KEY=GH_r_TTTT_YU

# Cookie domain — leave blank for localhost in dev
DOMAIN=

# Redis — set USE_REDIS=true only if you have Redis running
USE_REDIS=false
REDIS_HOST=localhost
REDIS_PORT=6379

# CORS — leave blank in development (code allows all origins)
ALLOWED_ORIGINS=

# Token expiry in seconds — not actively wired up yet in JWT service
REFRESH_TOKEN_EXPIRY=604800   # 7 days
ACCESS_TOKEN_EXPIRY=600        # 10 minutes

# SMTP — email sending via Nodemailer
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
